# Required in production. The site refuses to start without them.
# SITE_ACCESS_CODE: what Valentina types at the entrance (5 tries / 15 min).
# AUTH_SECRET: at least 32 random characters (openssl rand -base64 48).
# Changing AUTH_SECRET logs every device out.
SITE_ACCESS_CODE=replace-me
AUTH_SECRET=replace-with-at-least-32-random-characters

# Separate signing authorisation for Gianmaria. At least 24 characters
# (the site refuses to start with a shorter one), server only, never the same
# as SITE_ACCESS_CODE. Leave empty to disable the contract desk.
CONTRACT_ADMIN_PASSPHRASE=replace-with-a-unique-long-random-passphrase

# Gianmaria's control panel (/admin). At least 24 characters, different from
# SITE_ACCESS_CODE; the site refuses to start with a shorter one. While
# CONTRACT_ADMIN_PASSPHRASE is still set it also opens the panel.
ADMIN_PASSPHRASE=replace-with-a-unique-long-random-passphrase

# Required for cross-device progress persistence. All values are server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PRIMARY_USER_ID=00000000-0000-4000-8000-000000000001

# Legacy projects may use this instead of SUPABASE_SECRET_KEY. Never set both.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key

# Optional. Defaults to OpenFreeMap Liberty when omitted.
# This value is public and embedded in the browser bundle.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional PRIVATE archive image. Both server-only values must be set together.
# Omit both to use the original, non-sensitive illustration.
# Never use NEXT_PUBLIC_ variables, public buckets, public/ files or signed URLs.
SPICY_ARCHIVE_BUCKET=
SPICY_ARCHIVE_OBJECT=
SPICY_ARCHIVE_IMAGE_ALT=
