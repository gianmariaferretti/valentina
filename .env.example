# Required in production. Use a long, random value for AUTH_SECRET.
SITE_ACCESS_CODE=replace-me
AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional. Defaults to OpenFreeMap Liberty when omitted.
# This value is public and embedded in the browser bundle.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
