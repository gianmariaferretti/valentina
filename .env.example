# Required in production. Use a long, random value for AUTH_SECRET.
SITE_ACCESS_CODE=replace-me
AUTH_SECRET=replace-with-at-least-32-random-characters

# Required for cross-device progress persistence. All values are server-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_PRIMARY_USER_ID=00000000-0000-4000-8000-000000000001

# Legacy projects may use this instead of SUPABASE_SECRET_KEY. Never set both.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-key

# Optional. Defaults to OpenFreeMap Liberty when omitted.
# This value is public and embedded in the browser bundle.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional PRIVATE archive image. Both server-only values must be set together.
# Omit both to use the original, non-sensitive illustration.
# Never use NEXT_PUBLIC_ variables, public buckets, public/ files or signed URLs.
SPICY_ARCHIVE_BUCKET=
SPICY_ARCHIVE_OBJECT=
SPICY_ARCHIVE_IMAGE_ALT=
