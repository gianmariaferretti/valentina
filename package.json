{
  "name": "vg-year-one",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:games": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/*.test.mjs",
    "test:contract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/relationship-contract.test.mjs",
    "validate:lessons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/validate-italian-lessons.mjs",
    "validate:italian-laboratory": "node scripts/validate-italian-laboratory.mjs",
    "schema:lessons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/show-italian-lesson-schema.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:games && npm run build"
  },
  "dependencies": {
    "@meteocons/svg": "^0.1.0",
    "@meteocons/svg-static": "^0.1.0",
    "@serwist/turbopack": "^9.5.15",
    "@supabase/supabase-js": "^2.117.3",
    "canvas-confetti": "^1.9.4",
    "cobe": "^2.0.1",
    "esbuild": "^0.28.2",
    "howler": "^2.2.4",
    "lucide-react": "^1.52.0",
    "maplibre-gl": "^6.13.0",
    "motion": "^14.0.0",
    "next": "^16.4.6",
    "pdf-lib": "1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.15",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
